{
  "name": "orynt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "pnpm --filter @codepawl/marketing-site build",
    "build:cli": "pnpm --filter @codepawl/cli build",
    "build:desktop": "pnpm --filter @codepawl/coding-apprentice build && pnpm --filter @codepawl/desktop build",
    "cli": "pnpm build:cli && node packages/cli/dist/main.js",
    "dev": "pnpm --filter @codepawl/marketing-site dev",
    "dev:desktop": "./scripts/dev-desktop-fedora.sh",
    "dev:desktop:web": "./scripts/dev-desktop-web.sh",
    "dev:marketing": "pnpm --filter @codepawl/marketing-site dev",
    "test": "pnpm --filter @codepawl/marketing-site test",
    "test:contracts": "pnpm --filter @codepawl/shared test && pnpm --filter @codepawl/ipc-contracts test",
    "test:cli": "pnpm --filter @codepawl/cli test",
    "test:desktop": "pnpm --filter @codepawl/desktop test",
    "test:eval": "pnpm --filter @codepawl/eval-harness test",
    "test:core": "pnpm --filter @codepawl/coding-apprentice build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/core-health.mjs",
    "test:core:codex-fixture": "pnpm --filter @codepawl/coding-apprentice build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/core-health.mjs --controlled-codex",
    "bench:repoops": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs",
    "bench:repoops:core": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs --core",
    "bench:repoops:controlled-codex": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs --controlled-codex",
    "bench:repoops:live-codex": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs --live-codex",
    "bench:repoops:v1:smoke": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs --live-v1 --smoke",
    "bench:repoops:v1:live": "pnpm --filter @codepawl/eval-harness build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/repoops-bench.mjs --live-v1",
    "bench:decision": "pnpm --filter @codepawl/eval-harness build && node scripts/decision-bench.mjs --controlled",
    "bench:decision:live": "pnpm --filter @codepawl/eval-harness build && node scripts/decision-bench.mjs --live",
    "bench:decision:v2": "pnpm --filter @codepawl/eval-harness build && node scripts/decision-bench.mjs --controlled --v2",
    "bench:decision:v2:live": "pnpm --filter @codepawl/eval-harness build && node scripts/decision-bench.mjs --live --v2",
    "bench:decision:v3": "pnpm --filter @codepawl/eval-harness build && node scripts/decision-bench.mjs --controlled --v3",
    "bench:decision:v3:live": "pnpm --filter @codepawl/eval-harness build && pnpm --filter @codepawl/model-runtime build && node scripts/decision-bench.mjs --live --v3 --model gpt-5.6-luna --thinking-effort medium",
    "test:tauri": "node scripts/test-tauri.mjs",
    "release:desktop:check": "node --test scripts/private-beta-release.test.mjs",
    "package:desktop:internal": "node scripts/package-desktop-internal.mjs",
    "walkthrough:smoke": "pnpm --filter @codepawl/coding-apprentice build && pnpm --filter @codepawl/skill-registry build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/mvp-walkthrough-smoke.mjs",
    "walkthrough:real-codex": "pnpm --filter @codepawl/coding-apprentice build && node --import ./scripts/register-extensionless-esm-loader.mjs scripts/real-codex-walkthrough.mjs",
    "preview:marketing": "pnpm --filter @codepawl/marketing-site preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1"
  }
}
