{
  "name": "codepawl",
  "private": true,
  "workspaces": ["apps/web", "packages/*"],
  "scripts": {
    "dev": "bun --filter @codepawl/web dev",
    "dev:web": "rm -rf apps/web/.next/dev && bun --filter @codepawl/web dev",
    "build": "bun --filter @codepawl/web build",
    "start": "bun --filter @codepawl/web start",
    "lint": "bun --filter @codepawl/web lint",
    "typecheck": "bun --filter @codepawl/web typecheck",
    "test": "bun --filter @codepawl/web test",
    "test:e2e": "bun --filter @codepawl/web test:e2e",
    "test:e2e:web": "cd apps/web && rm -rf .next/dev && CI=true bunx playwright test --reporter=line",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "test:api": "cd apps/api && uv run pytest",
    "lint:api": "cd apps/api && uv run ruff check .",
    "typecheck:api": "cd apps/api && uv run mypy ."
  }
}
