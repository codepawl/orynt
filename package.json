{
  "name": "codepawl",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@codepawl/web",
    "dev:web": "turbo run dev --filter=@codepawl/web",
    "dev:all": "turbo run dev",
    "dev:cli": "turbo run dev --filter=@codepawl/cli",
    "build": "turbo run build",
    "start": "turbo run start --filter=@codepawl/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "bun --filter @codepawl/web typecheck",
    "typecheck:shared": "bun --filter @codepawl/shared typecheck",
    "typecheck:core": "bun --filter @codepawl/core typecheck",
    "typecheck:cli": "bun --filter @codepawl/cli typecheck",
    "test": "turbo run test",
    "test:core": "bun --filter @codepawl/core test",
    "test:cli": "bun --filter @codepawl/cli test",
    "test:web": "bun --filter @codepawl/web test",
    "test:all": "turbo run test",
    "test:e2e": "cd apps/web && bunx playwright test --reporter=line",
    "test:e2e:prod": "cd apps/web && PLAYWRIGHT_BASE_URL=https://codepawl.com bunx playwright test --reporter=line",
    "test:e2e:headed": "cd apps/web && bunx playwright test --headed --reporter=line",
    "test:e2e:ui": "cd apps/web && bunx playwright test --ui",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --port 8000",
    "test:api": "cd apps/api && uv run pytest",
    "lint:api": "cd apps/api && uv run ruff check .",
    "typecheck:api": "cd apps/api && uv run mypy ."
  },
  "overrides": {
    "postcss": "8.5.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "turbo": "^2.9.16"
  }
}
