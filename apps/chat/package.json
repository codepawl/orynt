{
  "name": "@codepawl/chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "bun run --filter @codepawl/shared build && bun run --filter @codepawl/model-runtime build && bun run --filter @codepawl/agent-runtime build",
    "dev": "bun run prebuild && bun run --parallel dev:server dev:ui",
    "dev:server": "bun --watch src/server.ts",
    "dev:ui": "vite --host 127.0.0.1 --port 4317",
    "build": "bun run prebuild && tsc -p tsconfig.json && vite build",
    "start": "bun src/server.ts",
    "test": "bun test --preload ./src/test/setup.ts src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/react": "0.14.28",
    "@assistant-ui/react-markdown": "0.14.7",
    "@codepawl/agent-runtime": "workspace:*",
    "@codepawl/model-runtime": "workspace:*",
    "@codepawl/shared": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.10",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.3",
    "vite": "8.1.0"
  }
}
