{
  "name": "@codepawl/web",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:prod": "PLAYWRIGHT_BASE_URL=https://codepawl.com playwright test --reporter=line",
    "test:e2e:headed": "playwright test --headed --reporter=line",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@clerk/react": "^6.7.3",
    "@clerk/ui": "^1.15.0",
    "@codepawl/shared": "workspace:*",
    "@types/node": "22.5.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "katex": "^0.16.11",
    "motion": "^12.38.0",
    "posthog-js": "^1.375.0",
    "react": "19.2.3",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-wrap-balancer": "^1.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.3",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.0.2",
    "typescript": "^6.0.3",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.40.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-start": "^1.168.25",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.93.1"
  },
  "overrides": {
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3"
  }
