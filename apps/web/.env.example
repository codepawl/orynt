# Backend API URL — server-only (not exposed to browser)
BACKEND_API_URL=http://localhost:8000
# Backend API URL — client-side (exposed to browser, needed for client components)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Supabase Auth — get keys from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Publishable key (sb_publishable_...) — safe for client-side
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# GitHub API token — for fetching project docs from GitHub repos (server-only)
GITHUB_TOKEN=

# Admin revalidation secret — for on-demand ISR cache invalidation
ADMIN_REVALIDATE_SECRET=

# Sentry error monitoring — get DSN from: https://sentry.io/settings/YOUR_ORG/projects/
NEXT_PUBLIC_SENTRY_DSN=
