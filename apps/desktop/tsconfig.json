{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@codepawl/ipc-contracts": ["../../packages/ipc-contracts/src/index.ts"],
      "@codepawl/shared": ["../../packages/shared/src/index.ts"]
    },
    "strict": true,
    "target": "ES2022",
    "types": ["vite/client"],
    "verbatimModuleSyntax": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test/**"]
}
