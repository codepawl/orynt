{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orynt",
  "version": "0.1.0",
  "identifier": "dev.orynt.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:renderer",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:renderer",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orynt",
        "width": 1440,
        "height": 960,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.openai.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/orynt-desktop-sidecar"
    ],
    "resources": {
      "../../../packages/skill-registry/builtins/": "builtins/"
    },
    "icon": [
      "../build/icon.png",
      "../build/icon.ico",
      "../build/icon.icns"
    ]
  }
}
