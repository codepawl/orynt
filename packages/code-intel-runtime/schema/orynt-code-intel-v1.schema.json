{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orynt.dev/schema/code-intel-v1.json",
  "title": "Orynt Code Intelligence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schemaVersion",
    "requestId",
    "workspaceId",
    "snapshot",
    "status",
    "freshness",
    "data",
    "evidence",
    "page",
    "warnings",
    "metrics"
  ],
  "properties": {
    "protocol": { "const": "orynt.code-intel" },
    "schemaVersion": { "const": 1 },
    "requestId": { "type": "string", "pattern": "^ci_" },
    "workspaceId": { "type": "string" },
    "snapshot": {
      "type": "object",
      "required": [
        "revision",
        "contentHash",
        "dirty",
        "sessionEpoch",
        "serverFingerprint"
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "contentHash": { "type": "string" },
        "dirty": { "type": "boolean" },
        "sessionEpoch": { "type": "integer", "minimum": 0 },
        "serverFingerprint": { "type": "string" },
        "sessions": { "type": "array" }
      }
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "ambiguous",
        "warming",
        "stale",
        "unsupported",
        "error"
      ]
    },
    "freshness": { "enum": ["fresh", "warming", "stale"] },
    "data": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "enum": [
            "WORKSPACE_NOT_FOUND",
            "NO_LANGUAGE_ADAPTER",
            "SERVER_NOT_INSTALLED",
            "SERVER_START_FAILED",
            "SERVER_WARMING",
            "SERVER_CRASHED",
            "SERVER_RESTART_LIMIT",
            "REQUEST_TIMEOUT",
            "REQUEST_CANCELLED",
            "UNSUPPORTED_CAPABILITY",
            "SYMBOL_NOT_FOUND",
            "AMBIGUOUS_SELECTOR",
            "INVALID_POSITION",
            "STALE_SNAPSHOT",
            "STALE_CURSOR",
            "STALE_PREVIEW",
            "APPROVAL_REQUIRED",
            "APPROVAL_REJECTED",
            "OUTSIDE_WORKSPACE",
            "SYMLINK_ESCAPE",
            "INVALID_WORKSPACE_EDIT",
            "OVERLAPPING_EDITS",
            "EDIT_CONFLICT",
            "VERIFICATION_FAILED",
            "RECOVERY_REQUIRED",
            "INTERNAL_PROTOCOL_ERROR"
          ]
        },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    },
    "evidence": { "type": "array" },
    "page": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  }
}
