nges.","recommended":true},{"id":"existing_reference","label":"Use a reference","description":"Point to an existing specification, issue, branch, or example that defines the target model.","recommended":false},{"id":"internal_refactor_only","label":"Internal refactor only","description":"Keep behavior identical and select the smallest clearer internal model compatible with the current API.","recommended":false}]}],"assumptions":[]}}
