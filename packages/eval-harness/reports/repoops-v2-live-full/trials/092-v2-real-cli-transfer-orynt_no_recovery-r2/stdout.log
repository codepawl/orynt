":"outcome","options":[{"id":"latest_frame_only","label":"Latest frame only","description":"The terminal output should contain only the most recently rendered frame.","recommended":true},{"id":"single_write_per_repaint","label":"One write per repaint","description":"Each repaint may update the terminal, but must issue one output write.","recommended":false},{"id":"preserve_existing_frame","label":"Preserve existing frame","description":"Keep the current displayed frame unless content actually changes.","recommended":false}]}],"assumptions":[]}}
