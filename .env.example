# ===========================================
# Next.js (apps/web)
# ===========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (client-side for Auth UI only, server-side reads go through FastAPI)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Turnstile (public site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# PostHog (public key)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry (public DSN, sent to the browser)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# Sentry build-time auth token for source map uploads (set in CI and local
# production builds; not needed at runtime). Generate at
# https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
# with scopes: project:releases, org:read.
SENTRY_AUTH_TOKEN=sntrys_...

# ===========================================
# FastAPI (apps/api)
# ===========================================

# Supabase service role (server-side, full DB access)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# JWKS endpoint for asymmetric JWT verification (Phase 6 user-auth).
# Not read by the current API; placeholder for when auth endpoints land.
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# Database direct connection (for Supabase CLI migrations only; not read by the API)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@codepawl.com

# Cloudflare Turnstile (server secret)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Sentry (server DSN)
SENTRY_DSN=https://...@sentry.io/...

# GitHub API (for product stats sync)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=codepawl

# Admin API key for protected admin endpoints
ADMIN_API_KEY=generate-a-random-string-here

# Front-end origin allowed by CORS (set to the deployed web URL in prod)
SITE_URL=http://localhost:3000

# Expose /docs, /redoc, /openapi.json. Leave unset in production (404'd by default).
DOCS_PUBLIC=true

# ===========================================
# Deployment
# ===========================================
NODE_ENV=development
PYTHON_ENV=development
