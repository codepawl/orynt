# ===========================================
# Next.js (apps/web)
# ===========================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (client-side for Auth UI only, server-side reads go through FastAPI)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Turnstile (public site key)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# PostHog (public key)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry (public DSN)
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...

# ===========================================
# FastAPI (apps/api)
# ===========================================

# Supabase service role (server-side, full DB access)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=...

# Database direct connection (for migrations)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Resend (transactional email)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@codepawl.com

# Cloudflare Turnstile (server secret)
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# Sentry (server DSN)
SENTRY_DSN=https://...@sentry.io/...

# GitHub API (for product stats sync)
GITHUB_TOKEN=ghp_...
GITHUB_ORG=codepawl

# Admin API key for protected admin endpoints
ADMIN_API_KEY=generate-a-random-string-here

# ===========================================
# Deployment
# ===========================================
NODE_ENV=development
PYTHON_ENV=development
