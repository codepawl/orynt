---
interface Props {
  name: string;
  tagline: string;
  description: string;
  status: string;
  href?: string;
  ctaLabel?: string;
}

const { name, tagline, description, status, href, ctaLabel = "Read more" } = Astro.props;
---

<article class="blueprint-card flex flex-col gap-6 p-8">
  <header class="flex items-start justify-between gap-4">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-technical text-ratchet-500">
        {tagline}
      </p>
      <h3 class="mt-3 font-display text-3xl font-light text-ink-50">{name}</h3>
    </div>
    <span class="font-mono text-[10px] uppercase tracking-technical text-ink-400">
      {status}
    </span>
  </header>
  <p class="text-base leading-relaxed text-ink-200">{description}</p>
  {href && (
    <a
      href={href}
      class="mt-auto inline-flex items-center gap-2 self-start font-mono text-xs uppercase tracking-[0.1em] text-ratchet-300 transition-colors duration-200 hover:text-ratchet-500"
    >
      {ctaLabel}
      <span aria-hidden>›</span>
    </a>
  )}
</article>
