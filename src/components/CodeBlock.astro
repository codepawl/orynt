---
import { Code } from "astro:components";
import codepawlTheme from "../lib/codepawl-theme.json";

interface Props {
  code: string;
  lang?: "python" | "typescript" | "bash" | "json";
  filename: string;
  minHeight?: string;
}

const {
  code,
  lang = "python",
  filename,
  minHeight,
} = Astro.props;

const minHeightStyle = minHeight ? `min-height: ${minHeight};` : "";
---

<div
  class="blueprint-card relative flex flex-col overflow-hidden"
  style={minHeightStyle}
>
  <div class="flex items-center gap-3 border-b border-ink-700 bg-ink-950/40 px-5 py-3">
    <div class="flex items-center gap-1.5">
      <span class="block h-[10px] w-[10px] rounded-full bg-ink-700"></span>
      <span class="block h-[10px] w-[10px] rounded-full bg-ink-700"></span>
      <span class="block h-[10px] w-[10px] rounded-full bg-ratchet-500"></span>
    </div>
    <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-ink-400">
      {filename}
    </span>
  </div>
  <div class="no-scrollbar flex-1 overflow-hidden px-5 py-5">
    <Code
      code={code}
      lang={lang}
      theme={codepawlTheme as never}
    />
  </div>
</div>
