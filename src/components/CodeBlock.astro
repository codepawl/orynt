---
interface Props {
  filename: string;
  hint?: string;
}

const { filename, hint } = Astro.props;
---

<div class="border border-ink-700 bg-ink-900">
  <div class="flex items-center justify-between border-b border-ink-700 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-400">
    <div class="flex items-center gap-3">
      <div class="flex gap-1.5">
        <span class="inline-block h-2 w-2 rounded-full bg-ink-700"></span>
        <span class="inline-block h-2 w-2 rounded-full bg-ink-700"></span>
        <span class="inline-block h-2 w-2 rounded-full bg-ratchet-500"></span>
      </div>
      <span>{filename}</span>
    </div>
    {hint && <span class="text-ink-500">{hint}</span>}
  </div>
  <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-[1.7] text-ink-200"><code><slot /></code></pre>
</div>
