---
import { Code } from "astro:components";
import type { ThemeRegistration } from "@shikijs/types";
import codepawlThemeJson from "../lib/codepawl-theme.json";

// JSON imports widen string literals (e.g. "dark" -> string), so the
// shiki ThemeRegistration cast is needed once at the boundary.
const codepawlTheme = codepawlThemeJson as unknown as ThemeRegistration;

type CodeLang =
  | "python"
  | "typescript"
  | "javascript"
  | "bash"
  | "shell"
  | "json"
  | "yaml"
  | "markdown"
  | "diff"
  | "html"
  | "css";

interface Props {
  filename: string;
  code: string;
  lang?: CodeLang;
  hint?: string;
  class?: string;
  noScrollbar?: boolean;
}

const {
  filename,
  code,
  lang = "python",
  hint,
  class: className = "",
  noScrollbar = false,
} = Astro.props;
---

<div class:list={["flex flex-col border border-ink-700 bg-ink-900", className]}>
  <div class="flex items-center justify-between border-b border-ink-700 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-400">
    <div class="flex items-center gap-3">
      <div class="file-tab-dots flex gap-1.5">
        <span class="bg-ink-700"></span>
        <span class="bg-ink-700"></span>
        <span class="bg-ratchet-500"></span>
      </div>
      <span>{filename}</span>
    </div>
    {hint && <span class="text-ink-500">{hint}</span>}
  </div>
  <div
    class:list={[
      "flex-1 px-5 py-4 font-mono text-[13px] leading-[1.7]",
      noScrollbar ? "no-scrollbar overflow-hidden" : "overflow-x-auto",
    ]}
  >
    <Code code={code} lang={lang} theme={codepawlTheme} />
  </div>
</div>
