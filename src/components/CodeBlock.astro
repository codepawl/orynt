---
interface Props {
  filename: string;
  hint?: string;
  class?: string;
}

const { filename, hint, class: className = "" } = Astro.props;
---

<div class:list={["flex flex-col border border-ink-700 bg-ink-900", className]}>
  <div class="flex items-center justify-between border-b border-ink-700 px-4 py-2 font-mono text-[11px] uppercase tracking-[0.2em] text-ink-400">
    <div class="flex items-center gap-3">
      <div class="file-tab-dots flex gap-1.5">
        <span class="bg-ink-700"></span>
        <span class="bg-ink-700"></span>
        <span class="bg-ratchet-500"></span>
      </div>
      <span>{filename}</span>
    </div>
    {hint && <span class="text-ink-500">{hint}</span>}
  </div>
  <pre class="flex-1 overflow-x-auto px-5 py-4 font-mono text-[13px] leading-[1.7] text-ink-200"><code><slot /></code></pre>
</div>
