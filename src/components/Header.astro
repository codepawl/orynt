---
import Logo from "./Logo.astro";

const navItems: ReadonlyArray<{ label: string; href: string; external?: boolean }> = [
  { label: "Products", href: "/products" },
  { label: "Diagnose", href: "/diagnose" },
  { label: "Log", href: "/log" },
  { label: "Changelog", href: "/changelog" },
  { label: "About", href: "/about" },
  { label: "GitHub", href: "https://github.com/codepawl", external: true },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="border-b border-ink-700/60">
  <div class="mx-auto flex max-w-container items-center justify-between px-6 py-5 lg:px-12 xl:px-8">
    <a
      href="/"
      class="group flex items-center gap-3 text-ratchet-500 transition-colors hover:text-ratchet-300"
      aria-label="Codepawl home"
    >
      <Logo class="text-ratchet-500 transition-colors group-hover:text-ratchet-300" />
      <span class="font-display text-xl font-light tracking-tighter-2 lowercase text-ink-50 transition-colors group-hover:text-ratchet-300">
        codepawl
      </span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-x-6 gap-y-2 font-mono text-[11px] uppercase tracking-technical">
        {
          navItems.map((item) => {
            const active = !item.external && isActive(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    "transition-colors duration-200",
                    active
                      ? "text-ratchet-300"
                      : "text-ink-200 hover:text-ink-50",
                  ]}
                  {...(item.external
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
