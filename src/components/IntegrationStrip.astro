---
const adapters: ReadonlyArray<string> = [
  "Langfuse",
  "LangSmith",
  "OpenTelemetry",
  "OpenAI SDK",
  "Anthropic SDK",
];

const adapterLine = adapters.join(" · ");
---

<div class="border-y border-ink-700/60 py-12">
  <div class="page-section mx-auto max-w-container">
    <p class="text-center font-mono text-xs uppercase tracking-technical text-ink-500">
      Adapters
    </p>
    <p class="mt-4 text-center font-mono text-sm uppercase tracking-technical text-ink-200">
      {adapterLine}
    </p>
    <p class="mt-3 text-center font-mono text-xs uppercase tracking-[0.1em] text-ink-400">
      We complement, we don't replace.
    </p>
  </div>
</div>
