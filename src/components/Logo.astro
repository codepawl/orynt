---
interface Props {
  size?: number;
  class?: string;
  ariaLabel?: string;
}

const {
  size = 28,
  class: className = "",
  ariaLabel = "Codepawl logo",
} = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="100 100 300 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label={ariaLabel}
>
  <rect x="100" y="100" width="300" height="300" rx="15" fill="#f5f4f0" />
  <line x1="192.675" y1="247.14" x2="215.068" y2="224.746" stroke="#070605" stroke-width="21.1132" stroke-linecap="round" />
  <line x1="215.069" y1="224.746" x2="192.675" y2="202.352" stroke="#070605" stroke-width="21.1132" stroke-linecap="round" />
  <line x1="285.269" y1="224.671" x2="316.938" y2="224.671" stroke="#070605" stroke-width="21.1132" stroke-linecap="round" />
  <circle cx="250.432" cy="286.955" r="15.8349" fill="#070605" />
</svg>
