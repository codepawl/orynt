  height={size}
  viewBox="0 0 28 28"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  role="img"
  aria-label={ariaLabel}
>
  <circle
    cx="14"
    cy="14"
    r="6"
    stroke="currentColor"
    stroke-width="1.25"
    fill="none"
  />
  <line x1="20" y1="14" x2="22.5" y2="14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
  <line x1="18.243" y1="18.243" x2="20.010" y2="20.010" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
  <line x1="14" y1="20" x2="14" y2="22.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
  <line x1="9.757" y1="18.243" x2="7.990" y2="20.010" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
  <line x1="8" y1="14" x2="5.5" y2="14" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
