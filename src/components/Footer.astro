---
const footerLinks: ReadonlyArray<{ label: string; href: string; external?: boolean }> = [
  { label: "GitHub", href: "https://github.com/codepawl", external: true },
  { label: "X", href: "https://x.com/codepawl", external: true },
  { label: "About", href: "/about" },
];
---

<footer class="mt-section border-t border-ink-700/60">
  <div
    class="page-section mx-auto flex max-w-container flex-col gap-4 py-10 font-mono text-[11px] uppercase tracking-technical text-ink-500 lg:flex-row lg:items-center lg:justify-between"
  >
    <p>CDPWL · 2026 · Built solo from Vietnam, moving to Berlin</p>
    <ul class="flex gap-6">
      {
        footerLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors duration-200 hover:text-ink-200"
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
