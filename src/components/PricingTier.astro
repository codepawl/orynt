---
type CtaVariant = "primary" | "secondary";

interface Props {
  name: string;
  price: string;
  perUnit?: string;
  context: string;
  features: ReadonlyArray<string>;
  ctaLabel: string;
  ctaHref: string;
  ctaVariant: CtaVariant;
  recommended?: boolean;
}

const {
  name,
  price,
  perUnit,
  context,
  features,
  ctaLabel,
  ctaHref,
  ctaVariant,
  recommended = false,
} = Astro.props;

const isExternal = ctaHref.startsWith("http");
const linkAttrs = isExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<article
  class:list={[
    "blueprint-card relative flex flex-col p-8",
    recommended &&
      "border-ratchet-500 bg-ratchet-500/[0.03] lg:-translate-y-4 lg:scale-[1.04]",
  ]}
>
  {
    recommended && (
      <div class="absolute -top-3 left-1/2 -translate-x-1/2">
        <span class="border border-ratchet-500 bg-ink-950 px-3 py-1 font-mono text-[10px] uppercase tracking-technical text-ratchet-300">
          Most popular
        </span>
      </div>
    )
  }
  <header>
    <p class="font-mono text-xs uppercase tracking-technical text-ratchet-300">
      {name}
    </p>
    <div class="mt-6 flex items-baseline gap-2">
      <span class="font-display text-5xl font-light leading-none text-ink-50">
        {price}
      </span>
      {perUnit && (
        <span class="font-mono text-xs uppercase tracking-technical text-ink-400">
          / month
        </span>
      )}
    </div>
    {perUnit && (
      <p class="mt-2 font-mono text-[11px] uppercase tracking-technical text-ink-500">
        {perUnit}
      </p>
    )}
    <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-ink-400">
      {context}
    </p>
  </header>
  <ul class="mt-8 mb-8 flex-1 space-y-3 border-t border-ink-700/60 pt-6">
    {features.map((feature) => (
      <li class="flex items-start gap-3 text-sm text-ink-200">
        <span class="font-mono text-ratchet-500" aria-hidden>
          ›
        </span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <a
    href={ctaHref}
    class:list={[
      ctaVariant === "primary" ? "btn-primary" : "btn-secondary",
      "justify-center",
    ]}
    {...linkAttrs}
  >
    {ctaLabel}
  </a>
</article>
