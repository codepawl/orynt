---
interface Props {
  name: string;
  price: string;
  period?: string;
  tagline: string;
  features: ReadonlyArray<string>;
  ctaLabel: string;
  ctaHref: string;
  ctaExternal?: boolean;
  primary?: boolean;
}

const {
  name,
  price,
  period,
  tagline,
  features,
  ctaLabel,
  ctaHref,
  ctaExternal = false,
  primary = false,
} = Astro.props;

const linkAttrs = ctaExternal
  ? { target: "_blank", rel: "noopener noreferrer" }
  : {};
---

<article class="blueprint-card flex flex-col gap-6 p-8">
  <header>
    <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
      {name}
    </p>
    <div class="mt-6 flex items-baseline gap-2">
      <span class="font-display text-5xl font-light text-ink-50">{price}</span>
      {period && (
        <span class="font-mono text-xs uppercase tracking-technical text-ink-400">
          {period}
        </span>
      )}
    </div>
    <p class="mt-3 font-mono text-xs uppercase tracking-[0.1em] text-ink-400">
      {tagline}
    </p>
  </header>
  <ul class="space-y-3 border-t border-ink-700/60 pt-6">
    {features.map((feature) => (
      <li class="flex items-baseline gap-3 text-sm text-ink-200">
        <span class="font-mono text-ratchet-500" aria-hidden>›</span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>
  <a
    href={ctaHref}
    class:list={["mt-auto self-start", primary ? "btn-primary" : "btn-secondary"]}
    {...linkAttrs}
  >
    {ctaLabel}
  </a>
</article>
