{
  "name": "codepawl",
  "type": "dark",
  "colors": {
    "editor.background": "#0d0c0a",
    "editor.foreground": "#c7c2b3"
  },
  "settings": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5a5547",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7a7466"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#5a8e72"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#ffb340"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "support.function.builtin",
        "support.function.magic",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#ff9500"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "punctuation.decorator",
        "meta.decorator punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#ff9500",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "meta.member.access",
        "meta.attribute",
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#ffb340"
      }
    },
    {
      "scope": [
        "variable.language",
        "variable.parameter.function.language.python"
      ],
      "settings": {
        "foreground": "#ffb340"
      }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": {
        "foreground": "#c7c2b3"
      }
    },
    {
      "scope": [
        "entity.name.class",
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#c7c2b3"
      }
    },
    {
      "scope": ["punctuation", "meta.brace", "meta.delimiter"],
      "settings": {
        "foreground": "#7a7466"
      }
    }
  ]
}
