{
  "name": "codepawl",
  "type": "dark",
  "settings": [
    {
      "settings": {
        "foreground": "#c7c2b3",
        "background": "#0d0c0a"
      }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#5a5547",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.expression",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7a7466"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6ba889"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null"
      ],
      "settings": {
        "foreground": "#ffc266"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator entity.name.function",
        "meta.function.decorator entity.name.function",
        "punctuation.decorator",
        "punctuation.definition.decorator",
        "meta.decorator punctuation.definition.decorator",
        "meta.function.decorator punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#ff9500",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["punctuation"],
      "settings": {
        "foreground": "#7a7466"
      }
    }
  ]
}
