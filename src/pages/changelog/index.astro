---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Em from "../../components/Em.astro";
import SectionMarker from "../../components/SectionMarker.astro";

const entries = await getCollection("changelog");
const sorted = entries.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const fmtDate = (d: Date): string =>
  d.toISOString().slice(0, 10).replace(/-/g, ".");
---

<Base
  title="Changelog"
  description="Every Codepawl release, dated. Build log lives at /log."
>
  {/* Hero */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 lg:py-32">
      <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
        Codepawl · changelog
      </p>
      <h1
        class="display-headline mt-10 text-4xl text-ink-50 md:text-7xl"
        style="line-height: 1.05;"
      >
        Every release. <Em>Dated</Em>.
      </h1>
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink-200">
        Product releases land here with version, date, and the change tags
        (release / fix / change / remove / security). For decisions and reasoning
        behind the work, read the <a
          href="/log"
          class="text-ratchet-300 transition-colors hover:text-ratchet-500">build log</a
        >.
      </p>
    </div>
  </section>

  {/* Entries */}
  <section>
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 lg:py-section">
      <SectionMarker number="001" label="Releases" />
      {sorted.length === 0 ? (
        <div class="mt-16 grid gap-6 border border-dashed border-ink-700/60 p-12 lg:grid-cols-12">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ratchet-500 lg:col-span-3">
            Pre-release
          </p>
          <p class="font-mono text-sm leading-relaxed text-ink-200 lg:col-span-9">
            First release lands when <span class="text-ink-50">Codepawl Trace v0.1</span> ships. Track progress in <a
              href="/log"
              class="text-ratchet-300 transition-colors hover:text-ratchet-500"
              >/log</a
            >.
          </p>
        </div>
      ) : (
        <ul class="mt-16 space-y-12">
          {sorted.map((entry) => (
            <li class="grid gap-6 border-b border-ink-700/60 pb-12 lg:grid-cols-12">
              <div class="lg:col-span-3">
                <p class="font-mono text-xs uppercase tracking-technical text-ink-400">
                  {fmtDate(entry.data.publishedAt)}
                </p>
                <p class="mt-2 font-mono text-sm uppercase tracking-technical text-ratchet-500">
                  {entry.data.version}
                </p>
                <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
                  {entry.data.tag}
                </p>
              </div>
              <div class="lg:col-span-9">
                <h2 class="font-display text-2xl font-light text-ink-50">
                  <a
                    href={`/changelog/${entry.slug}`}
                    class="transition-colors hover:text-ratchet-300"
                  >
                    {entry.data.title}
                  </a>
                </h2>
                <p class="mt-3 text-base leading-relaxed text-ink-200">
                  {entry.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
