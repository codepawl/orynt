---
import Base from "../layouts/Base.astro";
import Em from "../components/Em.astro";
import SectionMarker from "../components/SectionMarker.astro";
---

<Base
  title="Notify"
  description="Codepawl Trace cloud launches Q3 2026. Watch the GitHub repo for the alpha tag and release announcement."
>
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 lg:py-32 xl:px-8">
      <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
        Codepawl · notify
      </p>
      <h1
        class="display-headline mt-10 text-4xl text-ink-50 md:text-7xl"
        style="line-height: 1.05;"
      >
        Cloud launches <Em>Q3 2026</Em>.
      </h1>
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink-200">
        Codepawl Trace is being built in public. The hosted dashboard ships in
        Q3 2026. Until then, the build log is the source of truth.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 lg:py-section xl:px-8">
      <SectionMarker number="001" label="How to follow along" />
      <div class="mt-12 grid gap-12 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-8 lg:col-start-1">
          <p class="text-base leading-relaxed text-ink-200">
            We don't run a waitlist. No email capture, no exit-intent modal, no
            "Get notified" form. The Codepawl Trace repository is where releases
            happen.
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            Star or watch the repo to get the alpha-release notification when
            v0.1 ships. Releases are also surfaced on the changelog page.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="https://github.com/codepawl/trace"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              View on GitHub
            </a>
            <a href="/changelog" class="btn-secondary">Read the changelog</a>
            <a href="/log" class="btn-secondary">Read the build log</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
