---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const entries = await getCollection("log");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"log">;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const publishedDate = entry.data.publishedAt
  .toISOString()
  .slice(0, 10)
  .replace(/-/g, ".");
---

<Base title={entry.data.title} description={entry.data.description}>
  <article class="page-section">
    <div class="mx-auto max-w-3xl py-32">
      <p class="technical-label">{publishedDate} · {entry.data.tag}</p>
      <h1 class="display-headline mt-8 text-3xl text-ink-50 md:text-5xl">
        {entry.data.title}
      </h1>
      <p class="mt-6 text-lg text-ink-200">{entry.data.description}</p>

      <div
        class="mt-16 font-sans text-base leading-relaxed text-ink-200 [&_a]:text-ratchet-300 [&_a]:transition-colors hover:[&_a]:text-ratchet-500 [&_code]:font-mono [&_code]:text-ratchet-300 [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-light [&_h2]:text-ink-50 [&_h3]:mt-8 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-light [&_h3]:text-ink-50 [&_p]:mt-6 [&_pre]:mt-6 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-ink-700 [&_pre]:bg-ink-900 [&_pre]:p-5 [&_pre]:font-mono [&_pre]:text-[13px] [&_pre]:leading-relaxed"
      >
        <Content />
      </div>
    </div>
  </article>
</Base>
