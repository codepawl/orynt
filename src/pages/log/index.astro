---
import Base from "../../layouts/Base.astro";
---

<Base
  title="Log"
  description="Codepawl build log: decisions, ships, and tradeoffs from a one-person studio."
>
  <section class="px-6 lg:px-12">
    <div class="mx-auto max-w-container py-32">
      <p class="technical-label">Log stub</p>
      <h1 class="display-headline mt-8 text-4xl text-ink-50 md:text-7xl">
        Build log lands here
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-ink-200">
        Entries from the content collection to be wired in after design finalization.
      </p>
    </div>
  </section>
</Base>
