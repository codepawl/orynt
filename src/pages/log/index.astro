---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Em from "../../components/Em.astro";
import SectionMarker from "../../components/SectionMarker.astro";

const entries = await getCollection("log");
const sorted = entries.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);

const fmtDate = (d: Date): string =>
  d.toISOString().slice(0, 10).replace(/-/g, ".");
---

<Base
  title="Log"
  description="Codepawl build log. Decisions, ships, and tradeoffs from a one-person studio."
>
  {/* Hero */}
  <section class="border-b border-ink-700/60">
    <div class="page-section mx-auto max-w-container py-24 lg:py-32">
      <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
        Codepawl · build log
      </p>
      <h1
        class="display-headline mt-10 text-4xl text-ink-50 md:text-7xl"
        style="line-height: 1.05;"
      >
        Decisions, ships, <Em>tradeoffs</Em>.
      </h1>
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink-200">
        First-person notes on building Codepawl. The reasoning behind product
        choices, the things I tried and dropped, and the open questions still in
        front of me.
      </p>
    </div>
  </section>

  {/* Entries */}
  <section>
    <div class="page-section mx-auto max-w-container py-24 lg:py-section">
      <SectionMarker number="001" label="Entries" />
      {sorted.length === 0 ? (
        <div class="mt-16 border border-dashed border-ink-700/60 p-12 text-center">
          <p class="font-mono text-xs uppercase tracking-technical text-ink-500">
            No entries yet
          </p>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-ink-200 mx-auto">
            The first entry lands when Codepawl Trace v0.1 alpha goes out the
            door. Watch the GitHub repo for the alpha tag.
          </p>
          <a
            href="https://github.com/codepawl"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary mt-8 inline-flex"
          >
            View on GitHub
          </a>
        </div>
      ) : (
        <ul class="mt-16 space-y-12">
          {sorted.map((entry) => (
            <li class="grid gap-6 border-b border-ink-700/60 pb-12 lg:grid-cols-12">
              <div class="lg:col-span-3">
                <p class="font-mono text-xs uppercase tracking-technical text-ink-400">
                  {fmtDate(entry.data.publishedAt)}
                </p>
                <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.18em] text-ratchet-500">
                  {entry.data.tag}
                </p>
              </div>
              <div class="lg:col-span-9">
                <h2 class="font-display text-2xl font-light text-ink-50">
                  <a
                    href={`/log/${entry.slug}`}
                    class="transition-colors hover:text-ratchet-300"
                  >
                    {entry.data.title}
                  </a>
                </h2>
                <p class="mt-3 text-base leading-relaxed text-ink-200">
                  {entry.data.description}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>
