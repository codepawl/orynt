---
import Base from "../layouts/Base.astro";
import Em from "../components/Em.astro";
import SectionMarker from "../components/SectionMarker.astro";
import CodeBlock from "../components/CodeBlock.astro";
import PricingTier from "../components/PricingTier.astro";

const diagnoseFullCode = `from codepawl_trace import diagnose

trace = langfuse.get_trace(trace_id)
result = diagnose(trace)

result.failure_type
# "tool_misuse"

result.root_cause
# "schema mismatch on tools[0]"

result.suggested_fix
# "annotate enum on input.kind"

result.confidence
# 0.91
`;

const failureTypes: ReadonlyArray<{ name: string; summary: string }> = [
  {
    name: "Tool misuse",
    summary: "Agent called a tool with bad arguments or outside its contract.",
  },
  {
    name: "Hallucinated tool args",
    summary: "Agent invented values that don't exist in the schema.",
  },
  {
    name: "Broken plan",
    summary: "Multi-step plan diverges from the stated goal partway through.",
  },
  {
    name: "Lost context",
    summary: "Earlier turn dropped from the working window before it was needed.",
  },
  {
    name: "Infinite loop",
    summary: "Agent retries the same failing action with no state change.",
  },
  {
    name: "Retrieval miss",
    summary: "RAG returned irrelevant chunks. Agent answered from priors.",
  },
  {
    name: "Prompt injection",
    summary: "User input or tool output overwrote the system instructions.",
  },
  {
    name: "Format violation",
    summary: "Output doesn't match the declared schema or response format.",
  },
];

const adapters: ReadonlyArray<{ name: string; summary: string }> = [
  { name: "Langfuse", summary: "Read existing trace data via API." },
  { name: "LangSmith", summary: "Pull runs and project traces." },
  { name: "OpenTelemetry", summary: "Consume OTel-formatted spans." },
  { name: "OpenAI Agents SDK", summary: "Auto-instrument agent runs." },
  { name: "Anthropic SDK", summary: "Capture tool-use and message turns." },
  { name: "Raw HTTP", summary: "POST a JSON trace, get a diagnosis back." },
];
---

<Base
  title="Diagnose"
  description="Codepawl Trace explains why your AI agent failed. Structured failure type, root cause, and the exact fix to apply."
>
  {/* Hero */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-32">
      <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
        Product · Codepawl Trace
      </p>
      <h1
        class="display-headline mt-10 text-4xl text-ink-50 md:text-7xl"
        style="line-height: 1.05;"
      >
        A <Em>debugger</Em> that thinks.
      </h1>
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink-200">
        Codepawl Trace reads the traces you already have and adds a diagnostic
        layer on top. Failure type, root cause, suggested fix, confidence score.
        Built for engineers who already use Langfuse or LangSmith and want the
        layer above storage.
      </p>
    </div>
  </section>

  {/* 001 · The problem */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="001" label="The problem" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Tracing tools store. They don't <Em>explain</Em>.
      </h2>
      <div class="mt-12 grid gap-12 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-7 lg:col-start-1">
          <p class="text-base leading-relaxed text-ink-200">
            You ship an agent. It works in eval. It fails in production. You open
            the trace, scroll the spans, squint at the tool calls, and try to
            reconstruct what your model was thinking three minutes ago.
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            Existing dashboards solve storage and visualization. They show you a
            tree. They don't tell you the tree is broken because tool number two
            was passed an enum value that wasn't in its schema, and the model
            looped on it.
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            That diagnosis is what every team writes by hand in a notebook. We
            wrote it once and turned it into a function call.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 002 · How diagnose() works */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="002" label="How diagnose() works" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        One call. Structured <Em>output</Em>.
      </h2>
      <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:items-start">
        <div class="space-y-5 lg:col-span-5">
          <p class="text-base leading-relaxed text-ink-200">
            Pass any trace object that matches one of our adapter shapes. Get back
            a typed result. No prompt engineering on your side.
          </p>
          <p class="text-base leading-relaxed text-ink-400">
            The judge model is tuned for agent failure modes specifically. Not a
            generic LLM-as-judge wrapper.
          </p>
        </div>
        <div class="lg:col-span-7">
          <CodeBlock filename="DIAGNOSE.PY" lang="python" code={diagnoseFullCode} />
        </div>
      </div>
    </div>
  </section>

  {/* 003 · Failure taxonomy */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="003" label="Failure taxonomy" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Eight modes. One <Em>label</Em> per trace.
      </h2>
      <div class="mt-12 grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          failureTypes.map((f) => (
            <div class="border-t border-ink-700/60 pt-5">
              <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
                {f.name}
              </p>
              <p class="mt-3 text-sm leading-relaxed text-ink-200">{f.summary}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 004 · Adapters */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="004" label="Adapters" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        We read the traces you <Em>already</Em> have.
      </h2>
      <div class="mt-12 grid gap-x-12 gap-y-6 md:grid-cols-2">
        {
          adapters.map((a) => (
            <div class="flex items-baseline justify-between gap-6 border-b border-ink-700/60 pb-4">
              <span class="font-mono text-sm uppercase tracking-technical text-ink-50">
                {a.name}
              </span>
              <span class="text-right text-sm text-ink-400">{a.summary}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* 005 · Pricing */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="005" label="Pricing" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Free if you self-host. Cheap if you <Em>don't</Em>.
      </h2>
      <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8 lg:pt-6">
        <PricingTier
          name="Self-host"
          price="Free"
          context="No limits"
          features={["Open source", "Run anywhere", "All adapters", "All diagnostics"]}
          ctaLabel="View on GitHub"
          ctaHref="https://github.com/codepawl/trace"
          ctaVariant="secondary"
        />
        <PricingTier
          name="Hobbyist"
          price="$19"
          perUnit="$0.0019 per diagnosis"
          context="Cloud · 1 user"
          features={[
            "10k diagnoses / month",
            "Hosted dashboard",
            "Email support",
            "All adapters",
          ]}
          ctaLabel="Notify on launch"
          ctaHref="/notify"
          ctaVariant="primary"
          recommended
        />
        <PricingTier
          name="Team"
          price="$49"
          perUnit="$0.0005 per diagnosis"
          context="Cloud · 5 users"
          features={[
            "100k diagnoses / month",
            "Hosted dashboard",
            "Priority support",
            "All adapters",
          ]}
          ctaLabel="Notify on launch"
          ctaHref="/notify"
          ctaVariant="secondary"
        />
      </div>
      <p class="mt-8 font-mono text-xs uppercase tracking-[0.1em] text-ink-500">
        Annual: 17% off. Cloud launches Q3 2026.
      </p>
    </div>
  </section>

  {/* CTA */}
  <section>
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="006" label="Ship" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Read the spec. Then <Em>install</Em>.
      </h2>
      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="https://github.com/codepawl"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          View on GitHub
        </a>
        <a href="/log" class="btn-secondary">Read the build log</a>
      </div>
    </div>
  </section>
</Base>
