---
import Base from "../layouts/Base.astro";
import Em from "../components/Em.astro";
import SectionMarker from "../components/SectionMarker.astro";
import CodeBlock from "../components/CodeBlock.astro";
import IntegrationStrip from "../components/IntegrationStrip.astro";
import PricingTier from "../components/PricingTier.astro";
import ComparisonTable from "../components/ComparisonTable.astro";

const comparisonRows = [
  {
    feature: "Trace storage",
    langfuse: "yes",
    trace: "partial",
    traceNote: "we read yours",
  },
  { feature: "Cost dashboards", langfuse: "yes", trace: "no" },
  { feature: "Failure diagnosis", langfuse: "no", trace: "yes" },
  { feature: "Root cause + suggested fix", langfuse: "no", trace: "yes" },
  { feature: "Eval suite runner", langfuse: "partial", trace: "yes" },
  { feature: "Self-host", langfuse: "partial", trace: "yes" },
] as const;

const heroCode = `from codepawl_trace import diagnose

trace = langfuse.get_trace(trace_id)
result = diagnose(trace)

print(result.failure_type)
# "tool_misuse"

print(result.suggested_fix)
# "agent.tools[0] schema mismatch"
`;

const adapterCode = `from codepawl_trace import adapter

trace = adapter.langfuse(
    api_key="lf_xxx"
)
`;

const diagnoseCardCode = `@trace
def call_agent(query: str):
    return diagnose(query)
`;

const fixCode = `result = diagnose(trace)

if result.confidence > 0.85:
    apply(result.suggested_fix)
`;
---

<Base
  title="Codepawl"
  description="Codepawl Trace is a failure-explanation layer for AI agent developers. Get structured diagnoses, root causes, and the exact fix to apply."
>
  {/* Hero */}
  <section class="page-section border-b border-ink-700/60">
    <div class="mx-auto max-w-container py-24 lg:py-32">
      <p class="font-mono text-xs uppercase tracking-technical text-ink-400">
        <span class="text-ratchet-500">Codepawl</span> · dev tools studio for AI builders
      </p>
      <div class="mt-10 grid gap-y-8 lg:grid-cols-12 lg:gap-x-16">
        <h1
          class="display-headline text-5xl text-ink-50 leading-[1.05] md:text-6xl lg:col-span-7 lg:row-start-1 lg:text-7xl xl:text-[6rem]"
        >
          Why did your <Em>AI</Em> fail?<br />
          We tell you. In 30 seconds.
        </h1>
        <p
          class="max-w-xl text-lg leading-relaxed text-ink-200 md:text-xl lg:col-span-7 lg:row-start-2"
        >
          Codepawl Trace is a failure-explanation layer for AI agent developers.
          Plug in your traces from Langfuse, LangSmith, OpenTelemetry, or raw SDK
          logs. Get structured diagnoses, root causes, and the exact fix to apply.
          Not another dashboard. A debugger that thinks.
        </p>
        <div class="flex flex-wrap gap-3 lg:col-span-7 lg:row-start-3">
          <a href="#how" class="btn-primary">See how it works</a>
          <a
            href="https://github.com/codepawl"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            View on GitHub
          </a>
        </div>
        <div class="lg:col-start-8 lg:col-span-5 lg:row-span-3 lg:row-start-1">
          <CodeBlock filename="AGENT.PY" lang="python" code={heroCode} minHeight="440px" />
        </div>
      </div>
    </div>
  </section>

  {/* Studio context line */}
  <section class="border-b border-ink-700/60">
    <div class="page-section mx-auto max-w-container py-8">
      <p class="font-mono text-xs uppercase tracking-technical text-ink-200">
        Codepawl <span class="text-ratchet-500">Trace</span> is the first product. More tools coming.
      </p>
    </div>
  </section>

  {/* Adapters */}
  <IntegrationStrip />

  {/* 001 · How it works */}
  <section id="how" class="border-b border-ink-700/60">
    <div class="page-section mx-auto max-w-container py-24 lg:py-section">
      <SectionMarker number="001" label="How it works" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Three steps. No new SDK to <Em>install</Em>.
      </h2>
      <div class="mt-16 grid gap-8 md:grid-cols-3 xl:gap-10">
        <article class="blueprint-card flex min-w-0 flex-col gap-5 p-7">
          <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
            01 · Plug in
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            Drop in our adapter for Langfuse, LangSmith, or OpenTelemetry. Or send
            raw traces over HTTP. We meet you where your traces live.
          </p>
          <CodeBlock filename="ADAPTER.PY" lang="python" code={adapterCode} minHeight="200px" />
        </article>
        <article class="blueprint-card flex min-w-0 flex-col gap-5 p-7">
          <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
            02 · Diagnose
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            Run <code class="font-mono text-ratchet-300">diagnose(trace)</code>.
            Get a structured failure type, root cause, and confidence score. Powered
            by an LLM judge tuned for agent failure modes.
          </p>
          <CodeBlock filename="DIAGNOSE.PY" lang="python" code={diagnoseCardCode} minHeight="200px" />
        </article>
        <article class="blueprint-card flex min-w-0 flex-col gap-5 p-7">
          <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
            03 · Fix
          </p>
          <p class="text-base leading-relaxed text-ink-200">
            Each diagnosis includes the exact fix to apply, with code. Not "try
            harder". The actual line to change.
          </p>
          <CodeBlock filename="FIX.PY" lang="python" code={fixCode} minHeight="200px" />
        </article>
      </div>
    </div>
  </section>

  {/* 002 · Comparison */}
  <section class="border-b border-ink-700/60">
    <div class="page-section mx-auto max-w-container py-24 lg:py-section">
      <SectionMarker number="002" label="Why not just use Langfuse?" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Dashboards show what happened. We tell you <Em>why</Em>.
      </h2>
      <div class="mt-12">
        <ComparisonTable rows={comparisonRows} />
      </div>
      <p class="mt-8 max-w-2xl font-mono text-sm leading-relaxed text-ink-400">
        We read your existing traces. We add the diagnostic layer you've been
        writing in notebooks.
      </p>
    </div>
  </section>

  {/* 003 · Pricing */}
  <section id="pricing" class="border-b border-ink-700/60">
    <div class="page-section mx-auto max-w-container py-32 lg:py-40">
      <SectionMarker number="003" label="Pricing" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Cheap enough to <Em>try</Em>. Open source if you want.
      </h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-200">
        Annual billing saves 17%. No card needed for self-host. Cloud cancels
        anytime, no quarterly contracts.
      </p>
      <div class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:gap-8 lg:pt-6">
        <PricingTier
          name="Self-host"
          price="Free"
          context="No limits"
          features={[
            "Open source, MIT license",
            "Run on your own infra",
            "All adapters included",
            "Full diagnose engine",
          ]}
          ctaLabel="View on GitHub"
          ctaHref="https://github.com/codepawl/trace"
          ctaVariant="secondary"
        />
        <PricingTier
          name="Hobbyist"
          price="$19"
          perUnit="$0.0019 per diagnosis"
          context="Cloud · 1 user"
          features={[
            "10,000 diagnoses per month",
            "Hosted dashboard, no setup",
            "Email support, 24h response",
            "All adapters included",
            "Cancel anytime",
          ]}
          ctaLabel="Notify on launch"
          ctaHref="/notify"
          ctaVariant="primary"
          recommended
        />
        <PricingTier
          name="Team"
          price="$49"
          perUnit="$0.0005 per diagnosis"
          context="Cloud · 5 users"
          features={[
            "100,000 diagnoses per month",
            "Hosted dashboard for the team",
            "Priority support, 4h response",
            "All adapters included",
            "Shared workspace, role-based access",
          ]}
          ctaLabel="Notify on launch"
          ctaHref="/notify"
          ctaVariant="secondary"
        />
      </div>
      <p class="mt-12 font-mono text-xs uppercase tracking-[0.1em] text-ink-500">
        Cloud launches Q3 2026 · Annual saves 17% on Hobbyist and Team
      </p>
    </div>
  </section>

  {/* 004 · Ship */}
  <section>
    <div class="page-section mx-auto max-w-container py-24 lg:py-section">
      <SectionMarker number="004" label="Ship" />
      <h2 class="display-headline mt-10 text-3xl text-ink-50 md:text-5xl">
        Stop guessing why your agent <Em>broke</Em>.
      </h2>
      <div class="mt-12 flex flex-wrap gap-3">
        <a
          href="https://github.com/codepawl"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          View on GitHub
        </a>
        <a href="/log" class="btn-secondary">Read the build log</a>
      </div>
    </div>
  </section>
</Base>
