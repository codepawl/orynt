---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Em from "../../components/Em.astro";
import SectionMarker from "../../components/SectionMarker.astro";
import ProductCard from "../../components/ProductCard.astro";

const allProducts = await getCollection("products");
const products = allProducts.sort((a, b) => a.data.order - b.data.order);

const statusLabel: Record<string, string> = {
  shipping: "Shipping · v0.1 alpha",
  alpha: "Alpha",
  beta: "Beta",
  planning: "Planning",
  coming: "Coming",
};
---

<Base
  title="Products"
  description="Codepawl ships dev tools for engineers building with AI. Codepawl Trace is the first product. More tools coming."
>
  {/* Hero */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-32">
      <p class="font-mono text-xs uppercase tracking-technical text-ratchet-500">
        Codepawl · products
      </p>
      <h1
        class="display-headline mt-10 text-4xl text-ink-50 md:text-7xl"
        style="line-height: 1.05;"
      >
        One product <Em>shipping</Em>. More on the way.
      </h1>
      <p class="mt-10 max-w-3xl text-lg leading-relaxed text-ink-200">
        Codepawl is a dev tools studio for engineers shipping AI systems. Each
        product solves one specific failure mode in the AI build loop. Trace is
        first because diagnosing why your agent broke is the bottleneck right
        now.
      </p>
    </div>
  </section>

  {/* Products grid */}
  <section class="border-b border-ink-700/60">
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="001" label="What we ship" />
      <div class="mt-16 max-w-2xl">
        {
          products.map((product) => (
            <ProductCard
              name={product.data.name}
              tagline={product.data.tagline}
              description={product.data.description}
              status={statusLabel[product.data.status] ?? product.data.status}
              href={product.data.href}
              ctaLabel="Open product page"
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* Studio note */}
  <section>
    <div class="mx-auto max-w-container px-6 py-24 lg:px-12 xl:px-8 lg:py-section">
      <SectionMarker number="002" label="How we pick what to build" />
      <h2 class="display-headline mt-10 max-w-3xl text-3xl text-ink-50 md:text-5xl">
        Solo team. <Em>One</Em> product at a time.
      </h2>
      <div class="mt-10 grid gap-12 lg:grid-cols-12">
        <p class="text-base leading-relaxed text-ink-200 lg:col-span-7">
          Each Codepawl product solves a real bottleneck I've felt while shipping
          AI agents. They share a brand, a design system, and a self-host-or-cloud
          pricing model. They don't share a database, and you don't have to use
          the others to use one.
        </p>
      </div>
    </div>
  </section>
</Base>
